class Student {
  String name;
  int rollNumber;
  double marks1;
  double marks2;
  double marks3;

  Student(
    this.name,
    this.rollNumber,
    this.marks1,
    this.marks2,
    this.marks3,
  );

  void calculateResult() {
    double average = (marks1 + marks2 + marks3) / 3;

    String grade;

    if (average >= 90) {
      grade = "A+";
    } else if (average >= 80) {
      grade = "A";
    } else if (average >= 70) {
      grade = "B";
    } else if (average >= 60) {
      grade = "C";
    } else if (average >= 50) {
      grade = "D";
    } else {
      grade = "F";
    }

    print("Name: $name");
    print("Roll Number: $rollNumber");
    print("Average: ${average.toStringAsFixed(2)}");
    print("Grade: $grade");
  }
}

void main() {
  Student student = Student(
    "Rahul",
    25,
    85,
    78,
    92,
  );

  student.calculateResult();
}
