void main() {
  String name = "Rahul";

  List<String> favouriteFoods = [
    "Pizza",
    "Biryani",
    "Pasta"
  ];

  // Attempt to convert name to integer
  try {
    int number = int.parse(name);
    print("Number: $number");
  } on FormatException {
    print("Format Error: '$name' cannot be converted into an integer.");
  }

  // Attempt to access an invalid list index
  try {
    print(favouriteFoods[5]);
  } on RangeError {
    print("Range Error: The requested food index is out of range.");
  }
}
